# Copiar a .env y completar:  cp .env.example .env
# El .env no se sube al repositorio.

# Clave de OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=

# Modelo entregado (elegido con la comparación de evidencia/; ver DECISIONES.md)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Instrucciones: "ejemplos" (con ejemplos) o "base" (solo reglas)
NOVA_VARIANTE=ejemplos

# Esfuerzo de razonamiento en modelos que razonan: minimal, low, medium, high,
# o "none" para desactivarlo. Vacío: el valor por defecto del modelo.
NOVA_RAZONAMIENTO=

# Segundos máximos de espera al modelo (con 1 reintento). Si no responde, la API devuelve 503.
NOVA_TIMEOUT_LLM=20

# Solo fuera de Docker (en docker compose ya apunta al contenedor de MLflow):
# MLFLOW_TRACKING_URI=http://localhost:5000
